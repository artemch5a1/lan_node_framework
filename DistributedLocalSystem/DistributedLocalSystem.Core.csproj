<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
    <PackageReference Include="UdpDiscovery.Net" Version="1.2.0" />
  </ItemGroup>
  <!--
    Ориентация по папкам:
    Abstractions/           — контракты (порты): репозиторий настроек, перезагрузка конфигурации
    Bootstrap/              — регистрация DI и расширения IApplicationBuilder
    NetDiscovery/           — фича LAN discovery (UDP, роль host/client)
      Model/                — DTO и настройки: DiscoveryOptions, состояние, NetStatusDto
      Identity/             — DiscoveryServiceIdentity (AppId / service name)
      Runtime/              — NetDiscoveryService, NetDiscoveryHostedService
      Configuration/        — перезагрузка настроек из БД (INetDiscoveryConfigurationReloadCoordinator)
    Infrastructure/         — внешние зависимости
      Persistence/          — SQLite, EF, реализации репозитория
      Udp/                  — обёртки UdpDiscovery.Net
      Middleware/           — HTTP-прокси на LAN-хост
    Properties/             — InternalsVisibleTo и т.п.
    GlobalUsings.cs
  -->
</Project>
